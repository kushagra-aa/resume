{
  "id": "minimal",
  "name": "Minimal",
  "description": "Typography-first design with generous whitespace and quiet details.",
  "version": "1.0.0",
  "controls": [
    {
      "key": "fontFamily",
      "label": "Font family",
      "type": "select",
      "variable": "--resume-font-family",
      "options": [
        {
          "label": "Clean sans-serif",
          "value": "Arial, Helvetica, sans-serif"
        },
        { "label": "Classic serif", "value": "Georgia, serif" }
      ],
      "defaultValue": "Arial, Helvetica, sans-serif"
    },
    {
      "key": "fontSize",
      "label": "Font size",
      "type": "range",
      "variable": "--resume-font-size",
      "min": 9,
      "max": 12,
      "step": 0.5,
      "unit": "pt",
      "defaultValue": 10
    },
    {
      "key": "accent",
      "label": "Accent color",
      "type": "color",
      "variable": "--resume-accent",
      "defaultValue": "#262626"
    },
    {
      "key": "pageMargin",
      "label": "Page margin",
      "type": "range",
      "variable": "--resume-page-margin",
      "min": 12,
      "max": 25,
      "step": 1,
      "unit": "mm",
      "defaultValue": 22
    },
    {
      "key": "sectionSpacing",
      "label": "Section spacing",
      "type": "range",
      "variable": "--resume-section-spacing",
      "min": 4,
      "max": 14,
      "step": 1,
      "unit": "mm",
      "defaultValue": 9
    },
    {
      "key": "lineSpacing",
      "label": "Line spacing",
      "type": "range",
      "variable": "--resume-line-spacing",
      "min": 1.2,
      "max": 1.8,
      "step": 0.05,
      "defaultValue": 1.7
    },
    {
      "key": "headingStyle",
      "label": "Heading style",
      "type": "select",
      "variable": "--resume-heading-transform",
      "options": [
        { "label": "Standard", "value": "none" },
        { "label": "Uppercase", "value": "uppercase" }
      ],
      "defaultValue": "none"
    }
  ]
}
