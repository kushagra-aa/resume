{
  "id": "split-column",
  "name": "Split Column",
  "description": "A refined two-column resume with a compact contact header, profile sidebar, and date-led work history.",
  "version": "1.0.0",
  "controls": [
    {
      "key": "fontFamily",
      "label": "Font family",
      "type": "select",
      "variable": "--resume-font-family",
      "options": [
        {
          "label": "Clean sans-serif",
          "value": "Arial, Helvetica, sans-serif"
        },
        {
          "label": "System sans-serif",
          "value": "Inter, ui-sans-serif, system-ui, sans-serif"
        }
      ],
      "defaultValue": "Arial, Helvetica, sans-serif"
    },
    {
      "key": "fontSize",
      "label": "Font size",
      "type": "range",
      "variable": "--resume-font-size",
      "min": 8.5,
      "max": 11,
      "step": 0.5,
      "unit": "pt",
      "defaultValue": 9
    },
    {
      "key": "accentColor",
      "label": "Text color",
      "type": "color",
      "variable": "--resume-accent",
      "defaultValue": "#252525"
    },
    {
      "key": "mutedColor",
      "label": "Muted text color",
      "type": "color",
      "variable": "--resume-muted",
      "defaultValue": "#858585"
    },
    {
      "key": "pageMargin",
      "label": "Page margin",
      "type": "range",
      "variable": "--resume-page-margin",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "mm",
      "defaultValue": 15
    },
    {
      "key": "sidebarWidth",
      "label": "Sidebar width",
      "type": "range",
      "variable": "--resume-sidebar-width",
      "min": 62,
      "max": 88,
      "step": 1,
      "unit": "mm",
      "defaultValue": 78
    }
  ]
}
