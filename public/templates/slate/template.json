{
  "id": "slate",
  "name": "Slate",
  "description": "A compact two-column resume with teal accents, timeline markers, and dark skill chips.",
  "version": "1.0.0",
  "controls": [
    {
      "key": "fontFamily",
      "label": "Font family",
      "type": "select",
      "variable": "--resume-font-family",
      "options": [
        {
          "label": "Clean sans-serif",
          "value": "Arial, Helvetica, sans-serif"
        },
        {
          "label": "System sans-serif",
          "value": "Inter, ui-sans-serif, system-ui, sans-serif"
        }
      ],
      "defaultValue": "Arial, Helvetica, sans-serif"
    },
    {
      "key": "accent",
      "label": "Accent color",
      "type": "color",
      "variable": "--resume-accent",
      "defaultValue": "#48a2a9"
    },
    {
      "key": "ink",
      "label": "Ink color",
      "type": "color",
      "variable": "--resume-ink",
      "defaultValue": "#344054"
    },
    {
      "key": "fontSize",
      "label": "Font size",
      "type": "range",
      "variable": "--resume-font-size",
      "min": 9,
      "max": 12,
      "step": 0.5,
      "unit": "pt",
      "defaultValue": 10.5
    },
    {
      "key": "pageMargin",
      "label": "Page margin",
      "type": "range",
      "variable": "--resume-page-margin",
      "min": 8,
      "max": 18,
      "step": 1,
      "unit": "mm",
      "defaultValue": 8
    }
  ]
}
