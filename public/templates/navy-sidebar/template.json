{
  "id": "navy-sidebar",
  "name": "Navy Sidebar",
  "description": "A structured two-column resume with a deep navy profile sidebar and a focused white content column.",
  "version": "1.0.0",
  "controls": [
    {
      "key": "fontFamily",
      "label": "Font family",
      "type": "select",
      "variable": "--resume-font-family",
      "options": [
        {
          "label": "Clean sans-serif",
          "value": "Arial, Helvetica, sans-serif"
        },
        {
          "label": "System sans-serif",
          "value": "Inter, ui-sans-serif, system-ui, sans-serif"
        }
      ],
      "defaultValue": "Arial, Helvetica, sans-serif"
    },
    {
      "key": "sidebarColor",
      "label": "Sidebar color",
      "type": "color",
      "variable": "--resume-sidebar-color",
      "defaultValue": "#263f68"
    },
    {
      "key": "accentColor",
      "label": "Accent color",
      "type": "color",
      "variable": "--resume-accent",
      "defaultValue": "#263f68"
    },
    {
      "key": "fontSize",
      "label": "Font size",
      "type": "range",
      "variable": "--resume-font-size",
      "min": 8.5,
      "max": 11,
      "step": 0.5,
      "unit": "pt",
      "defaultValue": 9
    },
    {
      "key": "pageMargin",
      "label": "Page margin",
      "type": "range",
      "variable": "--resume-page-margin",
      "min": 0,
      "max": 8,
      "step": 1,
      "unit": "mm",
      "defaultValue": 0
    },
    {
      "key": "sidebarWidth",
      "label": "Sidebar width",
      "type": "range",
      "variable": "--resume-sidebar-width",
      "min": 55,
      "max": 78,
      "step": 1,
      "unit": "mm",
      "defaultValue": 67
    }
  ]
}
